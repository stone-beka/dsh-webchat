{
  "name": "@stone-beka/dsh-webchat",
  "version": "0.2.0",
  "type": "module",
  "description": "DeepSeek's official web chat, embedded in DSH as a main-column panel and driven by your own API key — plus a branch map, chat search, pinning and export.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stone-beka/dsh-webchat.git"
  },
  "homepage": "https://github.com/stone-beka/dsh-webchat#readme",
  "bugs": {
    "url": "https://github.com/stone-beka/dsh-webchat/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "dist",
    "locale/*.json",
    "README.md",
    "NOTICE.md",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "deepseek",
    "chat",
    "plugin",
    "bundle"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
